cat > .gitignore <<'EOF'
# Umgebungsvariablen und Zugangsdaten
.env
.env.*

# Beispielkonfiguration darf versioniert werden
!.env.example

# Python
__pycache__/
*.py[cod]

# Lokale Python-Umgebungen
.venv/
venv/

# Betriebssystem / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Laufzeit-, Sicherungs- und temporäre Dateien
*.log
*.bak
*.backup
*.dump
*.sql
*.tmp
EOF