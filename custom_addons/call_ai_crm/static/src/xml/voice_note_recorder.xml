<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="call_ai_crm.VoiceNoteRecorder">
        <div style="display:flex;
                    align-items:center;
                    gap:8px;
                    flex-wrap:wrap;">

            <button type="button"
                    class="btn btn-success"
                    t-if="!state.recording"
                    t-att-disabled="!canRecord || state.transcribing || state.analyzing"
                    t-on-click="startRecording">
                🎙 Voice-Note
            </button>

            <button type="button"
                    class="btn btn-danger"
                    t-if="state.recording"
                    t-on-click="stopRecording">
                ⏹ Aufnahme stoppen
            </button>

            <span t-if="state.recording"
                  style="white-space:nowrap;">
                Aufnahme läuft …
            </span>

            <span t-if="state.transcribing"
                  style="white-space:nowrap;">
                Transkription läuft …
            </span>

            <span t-if="state.analyzing"
                  style="white-space:nowrap;">
                KI-Analyse läuft …
            </span>

            <!--
                Transkript und Analyse werden in diesem Entwicklungsschritt
                bewusst nur zur Funktionskontrolle angezeigt. Die Werte werden
                noch nicht automatisch in die CRM-Felder übernommen.
            -->
            <div t-if="state.transcript"
                 style="width:100%;
                        margin-top:4px;
                        white-space:normal;">
                <strong>Transkript:</strong>
                <t t-esc="state.transcript"/>
            </div>

            <div t-if="state.analysis"
                 style="width:100%;
                        margin-top:4px;
                        white-space:normal;">
                <strong>KI-Vorschlag:</strong>
                <div>
                    Leadstatus:
                    <t t-esc="state.analysis.lead_status"/>
                </div>
                <div>
                    Einwände:
                    <t t-esc="state.analysis.objections.join(', ') || 'keine'"/>
                </div>
                <div>
                    Wiedervorlage:
                    <t t-if="state.analysis.followup_requested">
                        <t t-esc="state.analysis.followup_expression"/>
                    </t>
                    <t t-else="">keine</t>
                </div>
                <div t-if="state.analysis.followup_requested">
                    Berechneter Termin:
                    <t t-if="state.analysis.followup_datetime">
                        <t t-esc="state.analysis.followup_datetime"/>
                    </t>
                    <t t-else="">nicht automatisch bestimmbar</t>
                </div>
                <div>
                    Notiz:
                    <t t-esc="state.analysis.note"/>
                </div>
            </div>

            <span t-if="state.error"
                  class="text-danger"
                  style="width:100%;
                         white-space:normal;"
                  t-esc="state.error"/>

        </div>
    </t>

</templates>
