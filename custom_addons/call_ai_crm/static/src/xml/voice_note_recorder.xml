<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="call_ai_crm.VoiceNoteRecorder">
        <div style="display:flex;
                    align-items:center;
                    gap:8px;
                    flex-wrap:wrap;">

            <button type="button"
                    class="btn btn-success"
                    t-if="!state.recording"
                    t-att-disabled="!canRecord || state.transcribing || state.analyzing"
                    t-on-click="startRecording">
                🎙 Voice-Note
            </button>

            <button type="button"
                    class="btn btn-danger"
                    t-if="state.recording"
                    t-on-click="stopRecording">
                ⏹ Aufnahme stoppen
            </button>

            <span t-if="state.recording"
                  style="white-space:nowrap;">
                Aufnahme läuft …
            </span>

            <span t-if="state.transcribing"
                  style="white-space:nowrap;">
                Transkription läuft …
            </span>

            <span t-if="state.analyzing"
                  style="white-space:nowrap;">
                KI-Analyse läuft …
            </span>

            <!--
                Transkript und technische KI-Ausgabe werden nach der
                Entwicklungsphase nicht mehr angezeigt. Der Mitarbeiter
                prüft stattdessen direkt die vorbelegten Entwurfsfelder.
            -->
            <span t-if="state.analysis"
                  class="text-success"
                  style="white-space:nowrap;">
                Vorschläge übernommen
            </span>

            <span t-if="state.error"
                  class="text-danger"
                  style="width:100%;
                         white-space:normal;"
                  t-esc="state.error"/>

        </div>
    </t>

</templates>
