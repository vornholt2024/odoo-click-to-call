<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="call_ai_crm.VoiceNoteRecorder">
        <div style="display:flex;
                    align-items:center;
                    gap:8px;
                    flex-wrap:nowrap;">

            <button type="button"
                    class="btn btn-success"
                    t-if="!state.recording"
                    t-att-disabled="!canRecord || state.transcribing"
                    t-on-click="startRecording">
                🎙 Voice-Note
            </button>

            <button type="button"
                    class="btn btn-danger"
                    t-if="state.recording"
                    t-on-click="stopRecording">
                ⏹ Aufnahme stoppen
            </button>

            <span t-if="state.recording"
                  style="white-space:nowrap;">
                Aufnahme läuft …
            </span>

            <span t-if="state.transcribing"
                  style="white-space:nowrap;">
                Transkription läuft …
            </span>

            <span t-if="state.transcript"
                  style="white-space:normal;">
                <strong>Transkript:</strong>
                <t t-esc="state.transcript"/>
            </span>

            <span t-if="state.error"
                  class="text-danger"
                  style="white-space:normal;"
                  t-esc="state.error"/>

        </div>
    </t>

</templates>
