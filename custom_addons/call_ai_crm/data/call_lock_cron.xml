<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Prüft regelmäßig abgelaufene Kontaktreservierungen.

            Laufende Telefonate werden erneut für zehn Minuten reserviert.
            Abgelaufene Nachbearbeitungen werden beendet und nicht mehr
            benötigte Reservierungen werden freigegeben.
        -->
        <record id="ir_cron_process_expired_call_locks" model="ir.cron">
            <field name="name">Call AI CRM: Soft-Locks prüfen</field>

            <field name="model_id"
                   ref="base.model_res_partner"/>

            <field name="state">code</field>

            <field name="code">
                model._cron_process_expired_call_locks()
            </field>

            <!-- Einmal pro Minute und ohne Begrenzung wiederholen -->
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>

            <field name="active">True</field>
        </record>

    </data>
</odoo>